{
  "name": "krater-pro",
  "version": "0.1.0",
  "description": "Krater Pro: an independent Krater-powered coding agent for terminal, web, and native desktop.",
  "author": {
    "name": "Supratim Sircar",
    "url": "https://www.linkedin.com/in/supratimsircar/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupratimSircar05/krater-pro.git"
  },
  "homepage": "https://github.com/SupratimSircar05/krater-pro#readme",
  "bugs": {
    "url": "https://github.com/SupratimSircar05/krater-pro/issues"
  },
  "type": "module",
  "bin": {
    "krater": "./dist/cli.js",
    "krater-pro": "./dist/cli.js"
  },
  "workspaces": [
    "web",
    "cloud"
  ],
  "files": [
    "dist",
    "web/dist",
    "web/src/assets",
    "src",
    "!src/**/*.test.ts",
    "skills",
    "docs",
    "benchmarks",
    "!benchmarks/**/*.test.ts",
    "!benchmarks/**/test_*.py",
    "!benchmarks/**/__pycache__/**",
    "!benchmarks/**/.artifacts/**",
    "!benchmarks/**/.build/**",
    "!benchmarks/**/.work/**",
    "!benchmarks/**/results/**",
    ".env.example",
    "README.md",
    "LICENSE",
    "UPSTREAM_REFERENCE.md"
  ],
  "scripts": {
    "build": "npm run build --workspace web && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "dev:web": "tsx src/cli.ts web --dev",
    "cloud:dev": "npm run dev --workspace @krater-pro/cloud",
    "cloud:migrate:local": "npm run migrate:local --workspace @krater-pro/cloud",
    "cloud:migrate:remote": "npm run migrate:remote --workspace @krater-pro/cloud",
    "cloud:deploy": "npm run guard:secrets && npm run deploy --workspace @krater-pro/cloud",
    "cloud:test": "npm run test --workspace @krater-pro/cloud",
    "cloud:e2e": "npm run e2e --workspace @krater-pro/cloud",
    "cloud:guard": "npm run guard:secrets && npm run guard:secrets --workspace @krater-pro/cloud",
    "social:preview": "node scripts/build-social-preview.mjs",
    "desktop:icons": "node desktop/scripts/generate-icons.mjs",
    "desktop:test": "vitest run desktop/tests",
    "desktop:start": "electron desktop/main.mjs",
    "desktop:dev": "npm run build && npm run desktop:icons && electron desktop/main.mjs",
    "desktop:prepare": "npm run build && npm run desktop:icons && npm run desktop:test",
    "desktop:dist": "npm run desktop:prepare && node desktop/scripts/build.mjs",
    "desktop:dist:mac": "npm run desktop:prepare && node desktop/scripts/build.mjs --mac",
    "desktop:dist:win": "npm run desktop:prepare && node desktop/scripts/build.mjs --win",
    "desktop:dist:linux": "npm run desktop:prepare && node desktop/scripts/build.mjs --linux",
    "release:cli": "node scripts/release/build-cli-artifact.mjs --output release/cli --verify-reproducible",
    "release:sbom:desktop": "node scripts/release/create-sbom.mjs --profile desktop --output release/krater-pro-desktop.spdx.json",
    "release:test": "vitest run scripts/release packaging/homebrew desktop/tests",
    "guard:secrets": "node scripts/guard-secrets.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node --import tsx benchmarks/run.ts",
    "benchmark:validate": "node --import tsx benchmarks/run.ts --validate",
    "benchmark:evidence:validate": "node --import tsx benchmarks/evidence-native/runner.ts --validate",
    "benchmark:evidence:smoke": "node --import tsx benchmarks/evidence-native/runner.ts --smoke",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && npm run typecheck --workspace web"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion"
  },
  "keywords": [
    "krater",
    "coding-agent",
    "ai",
    "cli",
    "desktop",
    "electron",
    "ide"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "openai": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "brace-expansion": "file:vendor/brace-expansion-compat",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
