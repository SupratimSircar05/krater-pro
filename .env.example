# Create an API key in Krater Settings > API Keys.
KRATER_API_KEY=kr_live_your_key_here

# Optional overrides. "auto" uses Smart Router; an exact ID is a hard override.
KRATER_MODEL=auto
KRATER_BASE_URL=https://api.krater.ai/v1
KRATER_PORT=4317
KRATER_HOST=127.0.0.1

# Cost/context controls
KRATER_CONTEXT_CHARS=120000
KRATER_TOOL_OUTPUT_CHARS=18000
KRATER_RESPONSE_STYLE=concise
KRATER_MAX_STEPS=48
KRATER_MAX_OUTPUT_TOKENS=8192
KRATER_SESSION_TOKEN_BUDGET=250000
